<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every interface text is written as L("…"), in all projects. -->
    <Using Include="Split.Loc" Static="true" />
  </ItemGroup>
</Project>
