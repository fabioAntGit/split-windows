<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>splitapp</AssemblyName>
    <RootNamespace>Split.Cli</RootNamespace>
    <!-- One self-contained publish per architecture (-r win-x64 / win-arm64), loose files: Split.exe and splitapp.exe share one runtime folder. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <!-- Trimming breaks reflection-heavy WPF and COM late binding. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Split.Core\Split.Core.csproj" />
    <ProjectReference Include="..\Split.Windows\Split.Windows.csproj" />
  </ItemGroup>
</Project>