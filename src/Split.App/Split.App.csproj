<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Split</AssemblyName>
    <RootNamespace>Split.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- One self-contained publish per architecture: -r win-x64 / win-arm64. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming breaks reflection-heavy WPF and COM late binding. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="SkiaSharp.Views.WPF" />
    <!-- WPF leaves System.IO out of the implicit usings (Path would clash with the shape); the files that draw shapes name theirs. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inter and the Fluent icons are loaded from files next to the program, and the icon name tables are read from there too. -->
    <None Include="..\..\assets\fonts\*.ttf;..\..\assets\fonts\*.json" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Split.Core\Split.Core.csproj" />
    <ProjectReference Include="..\Split.Windows\Split.Windows.csproj" />
  </ItemGroup>
</Project>